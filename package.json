{
  "name": "videoagentvault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "docs:build": "node scripts/docs.mjs",
    "dev": "wrangler dev --port 8795",
    "pretest": "npm run cli:build",
    "cli:build": "node scripts/cli/contracts.mjs && tsc -p packages/cli/tsconfig.json && node scripts/cli/build.mjs",
    "cli:verify": "npm run cli:build && node scripts/cli/package.mjs && node scripts/cli/package-smoke.mjs",
    "mcp:verify": "node scripts/acceptance/mcp-inspector.mjs",
    "docs:readme": "node scripts/docs/readme.mjs"
  },
  "dependencies": {
    "hls.js": "1.7.2"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "5.9.3",
    "wrangler": "4.126.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
